    {"page": 1, "start": 0, "end": 46, "top": 72.0, "left": 72.0, "lastX": 267.6, "baseline": 82.58, "inkLeft": 72.024, "text": "The morning ferry crosses the estuary twice "},
    {"page": 1, "start": 46, "end": 89, "top": 85.2, "left": 72.0, "lastX": 261.6, "baseline": 96.02, "inkLeft": 72.024, "text": "before the tide turns, carrying commuters, "},
    {"page": 1, "start": 89, "end": 138, "top": 99.0, "left": 72.0, "lastX": 286.8, "baseline": 109.46, "inkLeft": 72.024, "text": "bicycles and crates of vegetables from the farms "},
    {"page": 1, "start": 138, "end": 186, "top": 112.2, "left": 72.0, "lastX": 286.2, "baseline": 122.93, "inkLeft": 72.024, "text": "on the far shore. Nobody on board hurries; they "},
    {"page": 1, "start": 186, "end": 235, "top": 126.0, "left": 72.0, "lastX": 288.0, "baseline": 136.37, "inkLeft": 72.024, "text": "read, drink tea from flasks and watch the herons "},
    {"page": 1, "start": 235, "end": 282, "top": 139.2, "left": 72.0, "lastX": 277.2, "baseline": 149.81, "inkLeft": 72.024, "text": "stand in the shallows. When the ferry docks, a "},
    {"page": 1, "start": 282, "end": 324, "top": 152.4, "left": 72.0, "lastX": 258.0, "baseline": 163.25, "inkLeft": 72.024, "text": "short queue forms along the jetty and the "},
