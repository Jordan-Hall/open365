    {"page": 1, "start": 0, "end": 100, "top": 72.0, "left": 72.0, "lastX": 516.0, "baseline": 82.58, "inkLeft": 72.024, "text": "The morning ferry crosses the estuary twice before the tide turns, carrying commuters, bicycles and "},
    {"page": 1, "start": 100, "end": 205, "top": 85.2, "left": 72.0, "lastX": 538.2, "baseline": 96.02, "inkLeft": 72.024, "text": "crates of vegetables from the farms on the far shore. Nobody on board hurries; they read, drink tea from "},
    {"page": 1, "start": 205, "end": 308, "top": 99.0, "left": 72.0, "lastX": 532.8, "baseline": 109.46, "inkLeft": 72.024, "text": "flasks and watch the herons stand in the shallows. When the ferry docks, a short queue forms along the "},
    {"page": 1, "start": 308, "end": 367, "top": 112.2, "left": 72.0, "lastX": 329.4, "baseline": 122.93, "inkLeft": 72.024, "text": "jetty and the deckhand coils the rope with practised ease.\u000d"},
    {"page": 1, "start": 367, "end": 397, "top": 132.0, "left": 72.0, "lastX": 204.0, "baseline": 142.37, "inkLeft": 72.024, "text": "Cell placement probe follows.\u000d"},
    {"page": 1, "start": 397, "end": 437, "top": 162.29, "left": 77.784, "lastX": null, "baseline": 162.29, "inkLeft": 77.784, "text": "Lanterns hang along the harbour wall and", "cell": true},
    {"page": 1, "start": 438, "end": 476, "top": 175.73, "left": 77.784, "lastX": null, "baseline": 175.73, "inkLeft": 77.784, "text": "swing gently whenever the evening wind", "cell": true},
    {"page": 1, "start": 477, "end": 516, "top": 189.17, "left": 77.784, "lastX": null, "baseline": 189.17, "inkLeft": 77.784, "text": "rises from the bay lighting the cobbles", "cell": true},
    {"page": 1, "start": 517, "end": 523, "top": 202.63, "left": 77.784, "lastX": null, "baseline": 202.63, "inkLeft": 77.784, "text": "below.", "cell": true},
    {"page": 1, "start": 525, "end": 566, "top": 162.29, "left": 277.8, "lastX": null, "baseline": 162.29, "inkLeft": 277.8, "text": "Orchard keepers gather windfall apples in", "cell": true},
    {"page": 1, "start": 567, "end": 609, "top": 175.73, "left": 277.8, "lastX": null, "baseline": 175.73, "inkLeft": 277.8, "text": "wicker baskets and sort bruised fruit from", "cell": true},
    {"page": 1, "start": 610, "end": 645, "top": 189.17, "left": 277.8, "lastX": null, "baseline": 189.17, "inkLeft": 277.8, "text": "sound before the cider press opens.", "cell": true},
    {"page": 1, "start": 648, "end": 689, "top": 242.71, "left": 77.784, "lastX": null, "baseline": 242.71, "inkLeft": 77.784, "text": "Beneath the viaduct a market sells cheese", "cell": true},
    {"page": 1, "start": 690, "end": 730, "top": 256.15, "left": 77.784, "lastX": null, "baseline": 256.15, "inkLeft": 77.784, "text": "and rye loaves with pickled beetroot and", "cell": true},
    {"page": 1, "start": 731, "end": 768, "top": 269.59, "left": 77.784, "lastX": null, "baseline": 269.59, "inkLeft": 77.784, "text": "knitted scarves to anyone passing by.", "cell": true},
    {"page": 1, "start": 770, "end": 808, "top": 242.71, "left": 277.8, "lastX": null, "baseline": 242.71, "inkLeft": 277.8, "text": "Snow settles quietly on the signal box", "cell": true},
    {"page": 1, "start": 809, "end": 851, "top": 256.15, "left": 277.8, "lastX": null, "baseline": 256.15, "inkLeft": 277.8, "text": "while the last freight train rumbles north", "cell": true},
    {"page": 1, "start": 852, "end": 890, "top": 269.59, "left": 277.8, "lastX": null, "baseline": 269.59, "inkLeft": 277.8, "text": "with its brake lamps glowing amber and", "cell": true},
    {"page": 1, "start": 891, "end": 895, "top": 283.06, "left": 277.8, "lastX": null, "baseline": 283.06, "inkLeft": 277.8, "text": "red.", "cell": true},
    {"page": 1, "start": 898, "end": 926, "top": 323.38, "left": 77.784, "lastX": null, "baseline": 323.38, "inkLeft": 77.784, "text": "Pupils in the village school", "cell": true},
    {"page": 1, "start": 927, "end": 953, "top": 336.82, "left": 77.784, "lastX": null, "baseline": 336.82, "inkLeft": 77.784, "text": "learn to read weather from", "cell": true},
    {"page": 1, "start": 954, "end": 982, "top": 350.26, "left": 77.784, "lastX": null, "baseline": 350.26, "inkLeft": 77.784, "text": "clouds and note each morning", "cell": true},
    {"page": 1, "start": 983, "end": 1017, "top": 363.72, "left": 77.784, "lastX": null, "baseline": 363.72, "inkLeft": 77.784, "text": "how high and how fast they travel.", "cell": true},
    {"page": 1, "start": 1019, "end": 1044, "top": 323.38, "left": 277.8, "lastX": null, "baseline": 323.38, "inkLeft": 277.8, "text": "Seed catalogues arrive in", "cell": true},
    {"page": 1, "start": 1045, "end": 1070, "top": 336.82, "left": 277.8, "lastX": null, "baseline": 336.82, "inkLeft": 277.8, "text": "January and the allotment", "cell": true},
    {"page": 1, "start": 1071, "end": 1102, "top": 350.26, "left": 277.8, "lastX": null, "baseline": 350.26, "inkLeft": 277.8, "text": "holders circle their favourites", "cell": true},
    {"page": 1, "start": 1103, "end": 1140, "top": 363.72, "left": 277.8, "lastX": null, "baseline": 363.72, "inkLeft": 277.8, "text": "long before the soil is ready to dig.", "cell": true},
    {"page": 1, "start": 1143, "end": 1144, "top": 372.6, "left": 72.0, "lastX": 72.0, "baseline": 383.64, "inkLeft": 72.024, "text": "\u000d"}
  ]
