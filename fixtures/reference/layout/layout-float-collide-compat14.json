    {"page": 1, "start": 1542, "end": 1592, "top": 364.8, "left": 331.2, "lastX": 539.4, "baseline": 375.24, "inkLeft": 331.08, "text": "sit without hiding a village. Every choice trades "},
    {"page": 1, "start": 1592, "end": 1612, "top": 378.0, "left": 72.0, "lastX": 144.0, "baseline": 388.68, "inkLeft": 72.024, "text": "detail for clarity, "},
    {"page": 1, "start": 1612, "end": 1657, "top": 378.0, "left": 331.2, "lastX": 527.4, "baseline": 388.68, "inkLeft": 331.08, "text": "and the reader trusts the result because the "},
    {"page": 1, "start": 1657, "end": 1674, "top": 391.2, "left": 72.0, "lastX": 153.0, "baseline": 402.12, "inkLeft": 72.024, "text": "trades were made "},
