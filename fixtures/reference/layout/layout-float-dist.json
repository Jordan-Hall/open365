    {"page": 2, "start": 4001, "end": 4104, "top": 178.2, "left": 72.0, "lastX": 527.4, "baseline": 188.69, "inkLeft": 72.024, "text": "tomorrow will do for the glue, since good work is not improved by being rushed past the point of care.\u000d"}
  ]
}
