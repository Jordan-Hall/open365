  "lines": [
    {"page": 1, "start": 0, "end": 48, "top": 72.0, "left": 72.0, "lastX": 287.4, "baseline": 82.58, "inkLeft": 72.024, "text": "The quick survey of a quiet harbour town begins "},
    {"page": 1, "start": 48, "end": 96, "top": 85.2, "left": 72.0, "lastX": 280.8, "baseline": 96.02, "inkLeft": 72.024, "text": "at dawn, when the fishing boats drift back past "},
    {"page": 1, "start": 96, "end": 143, "top": 99.0, "left": 72.0, "lastX": 276.6, "baseline": 109.46, "inkLeft": 72.024, "text": "the lighthouse and the market stalls fold open "},
    {"page": 1, "start": 143, "end": 192, "top": 112.2, "left": 72.0, "lastX": 286.8, "baseline": 122.93, "inkLeft": 72.024, "text": "their striped awnings. Gulls wheel over the quay "},
    {"page": 1, "start": 192, "end": 235, "top": 126.0, "left": 72.0, "lastX": 267.0, "baseline": 136.37, "inkLeft": 72.024, "text": "while merchants argue cheerfully about the "},
    {"page": 1, "start": 235, "end": 279, "top": 139.2, "left": 72.0, "lastX": 266.4, "baseline": 149.81, "inkLeft": 72.024, "text": "price of mackerel, and a baker carries warm "},
    {"page": 1, "start": 279, "end": 324, "top": 152.4, "left": 72.0, "lastX": 266.4, "baseline": 163.25, "inkLeft": 72.024, "text": "loaves across the cobbles to the cafe on the "},
    {"page": 1, "start": 324, "end": 369, "top": 166.2, "left": 72.0, "lastX": 261.0, "baseline": 176.69, "inkLeft": 72.024, "text": "corner. By noon the visitors arrive, and the "},
    {"page": 1, "start": 369, "end": 415, "top": 179.4, "left": 72.0, "lastX": 264.6, "baseline": 190.13, "inkLeft": 72.024, "text": "narrow streets fill with the sound of voices, "},
    {"page": 1, "start": 415, "end": 448, "top": 192.6, "left": 72.0, "lastX": 209.4, "baseline": 203.59, "inkLeft": 72.024, "text": "bicycle bells and distant music.\u000d"},
    {"page": 1, "start": 448, "end": 494, "top": 212.4, "left": 72.0, "lastX": 271.2, "baseline": 222.79, "inkLeft": 72.024, "text": "A short note of two lines, no more than that.\u000d"},
    {"page": 1, "start": 494, "end": 516, "top": 231.6, "left": 72.0, "lastX": 169.2, "baseline": 242.23, "inkLeft": 72.024, "text": "Another brief remark.\u000c"},
    {"page": 1, "start": 516, "end": 555, "top": 72.0, "left": 324.0, "lastX": 499.8, "baseline": 82.58, "inkLeft": 324.12, "text": "Typesetting depends on small decisions "},
    {"page": 1, "start": 555, "end": 603, "top": 85.2, "left": 324.0, "lastX": 538.8, "baseline": 96.02, "inkLeft": 324.12, "text": "repeated thousands of times: where a line ends, "},
    {"page": 1, "start": 603, "end": 643, "top": 99.0, "left": 324.0, "lastX": 511.2, "baseline": 109.46, "inkLeft": 324.12, "text": "how much space follows a paragraph, and "},
    {"page": 1, "start": 643, "end": 685, "top": 112.2, "left": 324.0, "lastX": 511.8, "baseline": 122.93, "inkLeft": 324.12, "text": "which words travel together across a page "},
    {"page": 1, "start": 685, "end": 729, "top": 126.0, "left": 324.0, "lastX": 525.0, "baseline": 136.37, "inkLeft": 324.12, "text": "boundary. A faithful reproduction must make "},
    {"page": 1, "start": 729, "end": 769, "top": 139.2, "left": 324.0, "lastX": 504.0, "baseline": 149.81, "inkLeft": 324.12, "text": "exactly the same decisions, because one "},
    {"page": 1, "start": 769, "end": 811, "top": 152.4, "left": 324.0, "lastX": 513.0, "baseline": 163.25, "inkLeft": 324.12, "text": "different break early in a document moves "},
    {"page": 1, "start": 811, "end": 861, "top": 166.2, "left": 324.0, "lastX": 529.8, "baseline": 176.69, "inkLeft": 324.12, "text": "every line that follows it onto a different page.\u000d"},
    {"page": 1, "start": 861, "end": 911, "top": 185.4, "left": 324.0, "lastX": 537.6, "baseline": 196.13, "inkLeft": 324.12, "text": "In the workshop the lamps stay lit late. Shavings "},
    {"page": 1, "start": 911, "end": 963, "top": 198.6, "left": 324.0, "lastX": 538.8, "baseline": 209.35, "inkLeft": 324.12, "text": "gather under the bench, a kettle ticks as it cools, "},
    {"page": 1, "start": 963, "end": 1017, "top": 212.4, "left": 324.0, "lastX": 538.8, "baseline": 222.79, "inkLeft": 324.12, "text": "and the half-finished chair waits for its last joint. "},
    {"page": 1, "start": 1017, "end": 1066, "top": 225.6, "left": 324.0, "lastX": 537.6, "baseline": 236.23, "inkLeft": 324.12, "text": "The maker steps back, squints along the rail and "},
    {"page": 1, "start": 1066, "end": 1110, "top": 239.4, "left": 324.0, "lastX": 515.4, "baseline": 249.67, "inkLeft": 324.12, "text": "decides that tomorrow will do for the glue.\u000d"},
    {"page": 1, "start": 1110, "end": 1160, "top": 258.6, "left": 324.0, "lastX": 529.8, "baseline": 269.11, "inkLeft": 324.12, "text": "The third item is a little longer than the others "},
    {"page": 1, "start": 1160, "end": 1203, "top": 271.8, "left": 324.0, "lastX": 507.0, "baseline": 282.58, "inkLeft": 324.12, "text": "so that it needs a second line in a narrow "},
    {"page": 1, "start": 1203, "end": 1211, "top": 285.6, "left": 324.0, "lastX": 360.0, "baseline": 296.02, "inkLeft": 324.12, "text": "column.\u000d"}
  ]
}
