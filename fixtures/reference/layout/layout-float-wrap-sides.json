    {"page": 1, "start": 677, "end": 705, "top": 225.6, "left": 72.0, "lastX": 197.4, "baseline": 236.23, "inkLeft": 72.024, "text": "way across the whole sheet.\u000d"},
    {"page": 1, "start": 705, "end": 815, "top": 245.4, "left": 72.0, "lastX": 539.4, "baseline": 255.67, "inkLeft": 72.024, "text": "In the workshop the lamps stay lit late. Shavings gather under the bench, a kettle ticks as it cools, and the "},
    {"page": 1, "start": 815, "end": 923, "top": 258.6, "left": 72.0, "lastX": 523.2, "baseline": 269.11, "inkLeft": 72.024, "text": "half-finished chair waits for its last joint. The maker steps back, squints along the rail and decides that "},
    {"page": 1, "start": 923, "end": 1026, "top": 272.4, "left": 72.0, "lastX": 527.4, "baseline": 282.58, "inkLeft": 72.024, "text": "tomorrow will do for the glue, since good work is not improved by being rushed past the point of care.\u000d"},
