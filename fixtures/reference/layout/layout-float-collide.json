    {"page": 2, "start": 4003, "end": 4106, "top": 159.0, "left": 72.0, "lastX": 527.4, "baseline": 169.25, "inkLeft": 72.024, "text": "tomorrow will do for the glue, since good work is not improved by being rushed past the point of care.\u000d"}
  ]
}
